# ─── Amazon SP-API Credentials ───────────────────────────────────────────────
# LWA (Login with Amazon) — 從 Seller Central > App Console 取得
SP_API_REFRESH_TOKEN=Atza|...
SP_API_CLIENT_ID=amzn1.application-oa2-client.xxx
SP_API_CLIENT_SECRET=your_client_secret

# Marketplace（預設 JP = A1VC38T7YXB528 / TW = A1805IZSGTT6HS / US = ATVPDKIKX0DER）
SP_API_MARKETPLACE_ID=A1VC38T7YXB528
SP_API_REGION=fe        # fe=Far East(JP/AU), na=North America, eu=Europe

# AWS STS（若使用 IAM Role assume，否則留空）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_ARN=

# ─── Amazon Advertising API (Ads) ────────────────────────────────────────────
ADS_CLIENT_ID=amzn1.application-oa2-client.xxx
ADS_CLIENT_SECRET=your_ads_client_secret
ADS_REFRESH_TOKEN=Atza|...
ADS_PROFILE_ID=          # 廣告帳號 Profile ID

# ─── DuckDB ──────────────────────────────────────────────────────────────────
DUCKDB_PATH=/data/sp_api.duckdb

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme_strong_password

# ─── ETL Settings ────────────────────────────────────────────────────────────
ETL_LOG_LEVEL=INFO
ETL_BATCH_SIZE=50           # SP-API 每次拉取訂單數量（max 100）
ORDERS_LOOKBACK_DAYS=7      # 預設拉取最近幾天的訂單
