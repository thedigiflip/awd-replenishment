{
  "name": "SP-API | Traffic Report Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 2 * *"
            }
          ]
        }
      },
      "id": "t0000001-0001-0001-0001-000000000001",
      "name": "Monthly 2nd @ 03:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "notes": "每月 2 日 03:00 UTC 觸發（1 日資料需等 Amazon 跑完當月結算）"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "param-marketplace",
              "name": "marketplace_id",
              "value": "ATVPDKIKX0DER",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "t0000001-0001-0001-0001-000000000002",
      "name": "Set Params",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "notes": "marketplace_id: US=ATVPDKIKX0DER / DE=A1PA6795UKMFR9 / UK=A1F83G8C2ARO7P"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://etl:8000/etl/traffic/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"marketplace_id\": \"{{ $json.marketplace_id }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "t0000001-0001-0001-0001-000000000003",
      "name": "Trigger Traffic Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "notes": "日期留空 → ETL 自動使用上個完整月份"
    },
    {
      "parameters": {
        "amount": 900,
        "unit": "seconds"
      },
      "id": "t0000001-0001-0001-0001-000000000004",
      "name": "Wait 15 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ],
      "notes": "SP-API 報告通常需要 5–15 分鐘，等待後再查詢狀態"
    },
    {
      "parameters": {
        "url": "http://etl:8000/etl/traffic/status",
        "options": {
          "timeout": 10000
        }
      },
      "id": "t0000001-0001-0001-0001-000000000005",
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "notes": "GET /etl/traffic/status — 回傳最新 run 的狀態"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "t0000001-0001-0001-0001-000000000006",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://etl:8000/etl/traffic/count",
        "options": {
          "timeout": 10000
        }
      },
      "id": "t0000001-0001-0001-0001-000000000007",
      "name": "Get Row Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "notes": "成功後查詢 sales_traffic 總筆數（可用於通知或 log）"
    },
    {
      "parameters": {
        "jsCode": "// 若狀態不是 success，拋出錯誤讓 n8n 記錄失敗\nconst status = $input.item.json.status;\nconst error  = $input.item.json.error_message || 'Unknown error';\nthrow new Error(`Traffic sync failed. Status: ${status}. Error: ${error}`);"
      },
      "id": "t0000001-0001-0001-0001-000000000008",
      "name": "Throw Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        400
      ],
      "notes": "狀態非 success 時拋出錯誤，n8n 會記錄失敗並可設定通知"
    }
  ],
