# ── 敏感資訊（絕對不能上傳）──────────────────────
.env
*.env

# ── 資料庫（本機資料，不同步）────────────────────
duckdb/
*.db
*.db.wal

# ── n8n 資料（包含 credentials）──────────────────
n8n/
# 例外：workflow JSON 檔要版本控制（不含機密，只有 placeholder credential id）
!n8n/*.json

# ── Python ───────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── macOS ────────────────────────────────────────
.DS_Store

# ── 其他 ─────────────────────────────────────────
*.xlsx
*.csv
